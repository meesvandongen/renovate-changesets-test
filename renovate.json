{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "postUpdateOptions": ["changesets"],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Only update the test dependencies",
      "matchPackageNames": ["!ms", "!semver", "!react", "!vue", "!is-number"],
      "enabled": false
    },
    {
      "description": "Group ms and semver, so lib-a/lib-e and lib-f get different changes in one branch",
      "matchPackageNames": ["ms", "semver"],
      "groupName": "ms and semver"
    },
    {
      "description": "Replace instead of widen the vue peer range, which breaks consumers",
      "matchPackageNames": ["vue"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "replace"
    }
  ]
}
